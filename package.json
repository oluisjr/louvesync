{
  "name": "louve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize_build.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "cleanup:duplicates": "node scripts/cleanup_duplicate_songs.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android && node scripts/configure_android.js",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug --no-daemon",
    "test:updates": "playwright test --config playwright.updates.config.js"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@supabase/supabase-js": "^2.106.1",
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.1.4",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.57.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "*",
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
