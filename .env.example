# SUPABASE (Frontend + Backend)
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE (Backend/Node scripts only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# STRIPE (SaaS Monetization)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# STRIPE PRICING PLANS (DO NOT COMMIT REAL PRICES)
STRIPE_PRICE_ID_FREE=price_free_tier_id_here
STRIPE_PRICE_ID_PRO_MONTHLY=price_pro_monthly_id_here
STRIPE_PRICE_ID_PRO_YEARLY=price_pro_yearly_id_here
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_id_here

# PRICING STRATEGY (Keep confidential)
PRO_PRICE_USD=199
PRO_PRICE_BRL=1099
ENTERPRISE_PRICE_USD=request
TRIAL_DAYS=7

# EMAIL SERVICE (Resend or SendGrid)
RESEND_API_KEY=re_your_resend_api_key_here
# OR
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# MONITORING & ANALYTICS (Backend)
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production

POSTHOG_API_KEY=your_posthog_api_key_here
POSTHOG_ENVIRONMENT=production

# OAUTH (for Google Sign-in)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# DATABASE & CACHE
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:password@host:5432/dbname

# API INTEGRATIONS (Future)
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here
LRCLIB_API_KEY=optional-if-private-api-later

# APP CONFIG (Can be public but keep structure safe)
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1

# VERCEL DEPLOYMENT
VERCEL_ENV=production
VERCEL_URL=https://louvesync.com

# GITHUB & GIT (if using GitHub Actions)
GITHUB_TOKEN=ghp_your_github_token_here
GIT_COMMIT_SHA=auto

# ADMIN/INTERNAL (HIGHLY CONFIDENTIAL)
ADMIN_MASTER_KEY=your_super_secret_admin_key_for_internal_operations
INTERNAL_API_TOKEN=internal_only_token_for_scripts
